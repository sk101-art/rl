{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-sre.local/contracts/user_save_decision_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "report_sha256", "decision", "actor", "decided_at"],
  "properties": {
    "schema_version": {"const": "rl.user-save-decision.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["SAVE", "DO_NOT_SAVE", "REVIEW_LATER"]},
    "actor": {"type": "string", "minLength": 1, "maxLength": 200},
    "decided_at": {"type": "string", "format": "date-time"},
    "comment": {"type": "string", "maxLength": 2000}
  }
}
